---
const skillCategories = [
  {
    title: "Full Stack Development",
    icon: "💻",
    skills: [
      { name: "JavaScript", level: 80 },
      { name: "React", level: 78 },
      { name: "Node.js", level: 70 },
      { name: "PostgreSQL (Stack PERN)", level: 72 },
      { name: "Tailwind CSS", level: 85 }
    ]
  },
  {
    title: "Redes e Infraestructura",
    icon: "🌐",
    skills: [
      { name: "CCNA", level: 85 },
      { name: "Cisco", level: 80 },
      { name: "Cableado Estructurado", level: 90 },
      { name: "Linux Administration", level: 80 },
      { name: "Windows Server", level: 75 }
    ]
  },
  {
    title: "DevOps (Ruta en curso)",
    icon: "🚀",
    skills: [
      { name: "Git & GitHub", level: 85 },
      { name: "Bash / Shell Scripting", level: 70 },
      { name: "Docker", level: 45 },
      { name: "CI/CD Pipelines", level: 15 },
      { name: "AWS (aprendiendo)", level: 30 }
    ]
  },
  {
    title: "Herramientas & Sistemas",
    icon: "🛠️",
    skills: [
      { name: "VS Code", level: 90 },
      { name: "Packet Tracer", level: 85 },
      { name: "Wireshark", level: 75 },
      { name: "IA como herramienta de desarrollo", level: 60 },
      { name: "GitHub Actions", level: 20 }
    ]
  }
];
---

<section id="skills" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
      <span class="neon-text">Habilidades Técnicas</span>
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      {skillCategories.map((category) => (
        <div class="bg-bg-card rounded-xl p-6 neon-border hover:scale-[1.02] transition-transform duration-300">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">{category.icon}</span>
            <h3 class="text-xl font-bold text-text-primary">{category.title}</h3>
          </div>

          <div class="space-y-4">
            {category.skills.map((skill) => (
              <div>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-text-secondary text-sm font-mono">{skill.name}</span>
                  <span class="text-neon-blue text-sm font-mono">{skill.level}%</span>
                </div>
                <div class="h-2 bg-bg-secondary rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-neon-blue to-neon-purple rounded-full transition-all duration-1000"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Additional tools -->
    <div class="mt-12 text-center">
      <p class="text-text-secondary mb-4">Capacitación continua en:</p>
      <div class="flex flex-wrap justify-center gap-3">
        {["Udemy", "Platzi", "YouTube", "Certificación CCNA", "IA + Programación"].map((tool) => (
          <span class="px-4 py-2 bg-bg-secondary/50 rounded-full text-text-secondary text-sm neon-border font-mono">
            {tool}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
